{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "EvenHold",
  "version": "../package.json",
  "identifier": "com.mysteriousseal.evenhold",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EvenHold",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#120e0c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "RolePlayingGame",
    "shortDescription": "A small isometric voxel adventure",
    "longDescription": "Wander a medieval voxel countryside, take work from village notice boards, and go down into the crypts beneath the old ruins and the caves in the hills.",
    "copyright": "\u00a9 2026 MysteriousSeal",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
